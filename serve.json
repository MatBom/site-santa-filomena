{
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/Landing Page.html" }
  ],
  "headers": [
    {
      "source": "**/*.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
